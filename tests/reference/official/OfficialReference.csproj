<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OsuSource Condition="'$(OsuSource)' == ''">$(MSBuildThisFileDirectory)../../../build/official-osu</OsuSource>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(OsuSource)/osu.Game.Rulesets.Osu/osu.Game.Rulesets.Osu.csproj" />
    <ProjectReference Include="$(OsuSource)/osu.Game.Rulesets.Taiko/osu.Game.Rulesets.Taiko.csproj" />
    <ProjectReference Include="$(OsuSource)/osu.Game.Rulesets.Catch/osu.Game.Rulesets.Catch.csproj" />
    <ProjectReference Include="$(OsuSource)/osu.Game.Rulesets.Mania/osu.Game.Rulesets.Mania.csproj" />
  </ItemGroup>
</Project>
